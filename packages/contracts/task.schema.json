{
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 100,
      "minLength": 8,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "instruction": {
      "maxLength": 4000,
      "minLength": 3,
      "title": "Instruction",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "mode": {
      "default": "review-first",
      "enum": [
        "review-first",
        "bounded-task"
      ],
      "title": "Mode",
      "type": "string"
    },
    "task_type": {
      "default": "desktop",
      "enum": [
        "desktop",
        "coding",
        "inspect"
      ],
      "title": "Task Type",
      "type": "string"
    },
    "expected_text": {
      "default": "",
      "maxLength": 2000,
      "title": "Expected Text",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "instruction",
    "project_id"
  ],
  "title": "TaskRequest",
  "type": "object"
}
